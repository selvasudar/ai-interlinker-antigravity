{
	"name": "ailsug/ai-internal-link-suggester",
	"description": "AI Internal Link Suggester WordPress plugin (dev tooling only; the plugin has no runtime dependencies).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"test:concurrency": "bash tests/concurrency/run.sh",
		"plugin-check": "wp plugin check ai-internal-link-suggester --exclude-directories=vendor,tests,node_modules,src,bin",
		"make-pot": "wp i18n make-pot . languages/ai-internal-link-suggester.pot --exclude=vendor,node_modules,tests,bin,src --domain=ai-internal-link-suggester",
		"build-zip": "bash bin/build-zip.sh"
	}
}
